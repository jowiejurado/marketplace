# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both are safe to expose in the browser; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional bonus: email the seller when a buyer messages them (https://resend.com → API Keys).
# Server-only. Without a verified domain, Resend only delivers to your own account email.
RESEND_API_KEY=
EMAIL_FROM=Marketplace <onboarding@resend.dev>
