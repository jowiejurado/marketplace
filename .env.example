# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both are safe to expose in the browser; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional bonus: email the seller when a buyer messages them (https://resend.com → API Keys).
# Server-only. Without a verified domain, Resend only delivers to your own account email.
RESEND_API_KEY=
EMAIL_FROM=Marketplace <onboarding@resend.dev>

# Payments (Test 4: Stripe Connect). All server-only except the publishable key.
# Supabase → Project Settings → API → service_role. Never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Stripe sandbox keys (test mode). Never commit real values.
# The publishable key is listed in the brief; this app redirects to hosted Checkout, so it is optional.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Printed once by scripts/create-webhook.mjs (or by `stripe listen` when testing locally).
STRIPE_WEBHOOK_SECRET=whsec_...
